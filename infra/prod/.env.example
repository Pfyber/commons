# Copy to infra/prod/.env and fill in. Never commit the real file.

# The address players type (DNS A/AAAA record pointing at this server).
COMMONS_DOMAIN=commons.example.org
# For Let's Encrypt expiry notices.
ACME_EMAIL=you@example.org

# 64 random characters: openssl rand -hex 32
COMMONS_SECRET=
# openssl rand -hex 16
POSTGRES_PASSWORD=

# Sign-in emails. Any SMTP provider works (Postmark, Brevo, SES, Mailgun…).
#   implicit TLS: smtps://USER:PASS@smtp.example.org:465
#   STARTTLS:     smtp://USER:PASS@smtp.example.org:587?tls=required
# URL-encode special characters in the password.
SMTP_URL=
MAIL_FROM=Commons <hello@commons.example.org>

# Your email (comma-separate several): the Caretaker's desk in the Town Hall.
COMMONS_CARETAKERS=you@example.org

# Optional: close the founding season on a date even if the grove isn't full.
COMMONS_FOUNDING_SEASON_END=

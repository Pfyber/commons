# One origin for everything; Caddy fetches and renews the TLS certificate.
{
	email {$ACME_EMAIL}
}

{$COMMONS_DOMAIN} {
	encode zstd gzip

	# Only the public routes: /internal, /metrics and /debug stay private.
	handle /api/join {
		reverse_proxy orchestrator:8081
	}
	handle /api/social/* {
		reverse_proxy social:8083
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /ws {
		reverse_proxy zone:8082
	}

	handle {
		root * /srv/client
		# Hashed build assets never change; the app shell always revalidates.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
